// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // O pooler do Supabase em modo Transaction (porta 6543) aceita o query
  // engine da aplicação, mas TRAVA o schema engine usado por `prisma migrate`
  // e `prisma db push`. As migrações rodam pela URL direta (porta 5432).
  // Sem esta linha o `prisma migrate dev` fica pendurado sem saída alguma.
  directUrl = env("DIRECT_URL")
}

// ==========================================================================
// Models do Better Auth
//
// Substituem os models do NextAuth (Account/Session/User/VerificationToken
// no formato OAuth do NextAuth), que não eram usados: o authOptions anterior
// só tinha CredentialsProvider com sessão em JWT e nem declarava `adapter`.
//
// Mudanças em relação ao formato anterior:
//   - `users.password`      -> `accounts.password` (providerId "credential")
//   - `users.emailVerified` -> DateTime? vira Boolean
//   - `sessions.sessionToken/expires` -> `sessions.token/expiresAt`
//   - `verificationTokens`  -> `verifications`
// ==========================================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Campo extra declarado em lib/auth.ts (advanced.user.additionalFields).
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Hash da senha para login por email/senha (providerId = "credential").
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ==========================================================================
// Models de negócio (inalterados pela migração de autenticação)
// ==========================================================================

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@map("clients")
}

model Appointment {
  id        String            @id @default(cuid())
  clientId  String
  service   String
  dateTime  DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("appointments")
}

enum UserRole {
  ADMIN
  BARBER
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}
