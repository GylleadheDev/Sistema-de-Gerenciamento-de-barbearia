# ==========================================================================
# CÓPIA ESTE ARQUIVO PARA `.env` E PREENCHA OS VALORES
#
#   cp .env.example .env
#
# O `.env` está no .gitignore e NUNCA deve ser commitado.
# Este .env.example é versionado de propósito: ele é o contrato que diz
# quais variáveis a aplicação exige. Sem ele, alguém copia o projeto e
# bate no PrismaClientConstructorValidationError sem saber por quê.
# ==========================================================================

# --------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL / Supabase)
# --------------------------------------------------------------------------
# Nome do banco no Supabase é sempre `postgres` (não "barbearia").
# Pool mode: 6543 = Transaction, 5432 = Session. Migrations rodam no DIRECT_URL.
DATABASE_URL="postgresql://postgres:SENHA@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:SENHA@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Se for usar MongoDB localmente (legado), descomente e remova directUrl do schema:
# DATABASE_URL="mongodb+srv://USER:SENHA@cluster0.xxxxx.mongodb.net/barbearia?retryWrites=true&w=majority"

# --------------------------------------------------------------------------
# SESSÃO / AUTENTICAÇÃO (Better Auth)
# --------------------------------------------------------------------------
# Gere um novo segredo:  openssl rand -base64 32
# BETTER_AUTH_SECRET é usado para assinar os cookies de sessão.
# NUNCA exponha com prefixo NEXT_PUBLIC_.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="gere-um-segredo-forte-com-openssl-rand-base64-32"

# Legado — o NextAuth foi removido em favor do Better Auth
# (ver MIGRACAO_BETTER_AUTH.md). lib/auth.ts ainda aceita estas como
# *fallback*, por isso podem existir em deploys antigos.
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="somente-fallback"

# --------------------------------------------------------------------------
# SEED (prisma/seed.ts)
# --------------------------------------------------------------------------
ADMIN_EMAIL="admin@barbearia.com"
ADMIN_PASSWORD="troque-esta-senha"

# --------------------------------------------------------------------------
# APLICAÇÃO
# --------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
